# =============================================================================
# Field Dashboard — local development environment
# =============================================================================
# Copy to .env.local and fill in values. Never commit .env.local.

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Service role key bypasses RLS. SERVER-SIDE ONLY.
# Used by /admin/* pages to read across tenants.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# App URL
# -----------------------------------------------------------------------------
# Used for redirects, email links, OAuth callbacks
# Production: https://app.getfield.co
# Local:      http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Admin access
# -----------------------------------------------------------------------------
# Comma-separated allowlist for /admin/* routes
ADMIN_EMAILS=dallintheriault@live.com

# -----------------------------------------------------------------------------
# Stripe (billing)
# -----------------------------------------------------------------------------
# Test mode (sk_test_...) for dev; rotate to sk_live_... for prod
STRIPE_SECRET_KEY=sk_test_your-test-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# -----------------------------------------------------------------------------
# Stripe — ESTIMATOR customer invoicing (separate from Field billing above)
# -----------------------------------------------------------------------------
# Restricted key from the TENANT'S Stripe account with exactly:
#   Customers (write), Invoices (write), Invoice Items (write)
# Unset = "Send with Stripe" disabled; PDF + manual invoicing still work.
ESTIMATOR_STRIPE_SECRET_KEY=
# Signing secret of a dedicated webhook endpoint pointing at
# https://app.getfield.co/api/stripe/estimator-webhook listening for
# the `invoice.paid` event.
ESTIMATOR_STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# n8n integrations
# -----------------------------------------------------------------------------
N8N_ONBOARD_WEBHOOK=https://dtheriault.app.n8n.cloud/webhook/onboard-client
