# Supabase project configuration
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: n8n webhook for onboarding new clients
N8N_ONBOARD_WEBHOOK=https://dtheriault.app.n8n.cloud/webhook/onboard-client

# Stripe — server-side only, never NEXT_PUBLIC_*
# Test mode key (sk_test_...) for development; rotate to sk_live_... for production.
# Used by /api/stripe/portal and /api/stripe/payment-link routes.
STRIPE_SECRET_KEY=sk_test_your-test-secret-key-here

# Admin access — comma-separated list of emails authorized to access /admin/*
# These users can generate payment links, view all clients, etc.
# Example: ADMIN_EMAILS=dallin@example.com,operator@example.com
ADMIN_EMAILS=dallintheriault@live.com

# Admin Supabase access — service role key bypasses RLS. SERVER-SIDE ONLY.
# Get from Supabase Dashboard → Project Settings → API → service_role key.
# Required for /admin/* pages to read across tenants.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
